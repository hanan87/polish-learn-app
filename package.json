{
  "name": "polish-learn-app",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build:standalone": "vite build --mode standalone && node scripts/copy-standalone.mjs",
    "build": "tsc --noEmit -p tsconfig.json && npm run build:standalone && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --host",
    "icons": "pwa-assets-generator",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "theme": "node scripts/gen-theme.mjs",
    "voice": "tsx scripts/gen-voice.ts"
  },
  "dependencies": {
    "@fontsource-variable/frank-ruhl-libre": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
